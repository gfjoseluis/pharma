# ===== Base de datos (MySQL) =====
DATABASE_URL="mysql://root:@localhost:3306/farmacia"
PORT=4000

# ===== Seguridad =====
JWT_SECRET="cambiar-esta-clave-por-una-segura"
JWT_EXPIRES="12h"

# ===== Google Drive (opcional, para backups) =====
# Ruta al archivo JSON de service account de Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=""
GOOGLE_DRIVE_FOLDER_ID=""

# ===== Base de datos para backups (mysqldump) =====
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="farmacia"
MYSQLDUMP_PATH="mysqldump"
