generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================= SUCURSALES =============================
model Branch {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  address   String?
  phone     String?
  type      String    @default("pequena") // pequena | mediana | grande
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  users     User[]
  stocks    Stock[]
  purchases Purchase[]
  sales     Sale[]
  movements StockMovement[]
}

// ============================= USUARIOS =============================
model User {
  id          Int      @id @default(autoincrement())
  username    String   @unique
  password    String
  fullName    String
  role        String   @default("cajero") // admin | cajero | tecnico
  branchId    Int?
  branch      Branch?  @relation(fields: [branchId], references: [id])
  permissions Json     @default("[]") // lista de modulos habilitados
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  sales       Sale[]
  movements   StockMovement[]
}

// ============================= INVENTARIO =============================
model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  active      Boolean   @default(true)
  products    Product[]
}

model Form {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  active      Boolean   @default(true)
  products    Product[]
}

model Laboratory {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  active        Boolean        @default(true)
  products      Product[]
  purchaseItems PurchaseItem[]
}

model UnitMeasure {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  shortName String?
  active    Boolean  @default(true)
  products  Product[]
}

model Supplier {
  id       Int               @id @default(autoincrement())
  name     String
  ruc      String?           @unique
  phone    String?
  email    String?
  address  String?
  active   Boolean           @default(true)
  products ProductSupplier[]
  purchases Purchase[]
}

model Product {
  id               Int                   @id @default(autoincrement())
  sku              String                @unique
  name             String
  barcode          String?
  categoryId    Int?
  category      Category?         @relation(fields: [categoryId], references: [id])
  laboratoryId  Int?
  laboratory    Laboratory?       @relation(fields: [laboratoryId], references: [id])
  unitMeasureId Int?
  unitMeasure   UnitMeasure?      @relation(fields: [unitMeasureId], references: [id])
  formId        Int?
  form          Form?             @relation(fields: [formId], references: [id])
  concentration String? // resumen opcional (ej: "500 mg"); la concentracion por principio activo va en ingredients
  restrictedUse Boolean           @default(false) // uso restringido (hospitalario, etc.)
  price         Decimal           @default(0) @db.Decimal(10, 2)
  costPrice     Decimal           @default(0) @db.Decimal(10, 2)
  minStock      Int               @default(0)
  active        Boolean           @default(true)
  createdAt     DateTime          @default(now())
  suppliers     ProductSupplier[]
  ingredients   ProductActiveIngredient[]
  restrictions  ProductRestriction[]
  stocks        Stock[]
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]
  movements     StockMovement[]
}

// Principios activos de un medicamento (puede tener varios: ej. ergotamina + paracetamol + cafeina)
model ProductActiveIngredient {
  id           Int     @id @default(autoincrement())
  productId    Int
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   String // nombre del principio activo (ej. Paracetamol)
  concentration String? // concentracion de ese principio (ej. "500 mg", "200 mg/5 ml")
}

// Restricciones de uso (ej. Hospitalario, Norma PAI)
model ProductRestriction {
  id              Int     @id @default(autoincrement())
  productId       Int
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  restrictionType String // Hospitalario | Norma PAI | Venta libre ...
  notes           String?
}

model ProductSupplier {
  productId  Int
  supplierId Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@id([productId, supplierId])
}

model Stock {
  id         Int      @id @default(autoincrement())
  branchId   Int
  branch     Branch   @relation(fields: [branchId], references: [id])
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  lot        String?
  expiryDate DateTime?
  quantity   Int      @default(0)

  @@unique([branchId, productId, lot])
}

model StockMovement {
  id             Int      @id @default(autoincrement())
  type           String // PURCHASE | DISTRIBUTION | TRANSFER_OUT | TRANSFER_IN | SALE | SIN_DISCHARGE | ADJUSTMENT
  productId      Int
  product        Product  @relation(fields: [productId], references: [id])
  branchId       Int
  branch         Branch   @relation(fields: [branchId], references: [id])
  targetBranchId Int?
  quantity       Int
  lot            String?
  userId         Int?
  user           User?    @relation(fields: [userId], references: [id])
  note           String?
  createdAt      DateTime @default(now())
}

// ============================= COMPRAS =============================
model Purchase {
  id            Int            @id @default(autoincrement())
  invoiceNumber String? // numero de factura del proveedor (referencia)
  supplierId    Int?
  supplier      Supplier?      @relation(fields: [supplierId], references: [id])
  branchId      Int
  branch        Branch         @relation(fields: [branchId], references: [id])
  date          DateTime       @default(now())
  total         Decimal        @default(0) @db.Decimal(10, 2)
  items         PurchaseItem[]
}

model PurchaseItem {
  id            Int        @id @default(autoincrement())
  purchaseId    Int
  purchase      Purchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId     Int
  product       Product    @relation(fields: [productId], references: [id])
  laboratoryId  Int? // snapshot del laboratorio al momento de la compra
  laboratory    Laboratory? @relation(fields: [laboratoryId], references: [id])
  quantity      Int
  unitCost      Decimal    @db.Decimal(10, 2)
  lot           String?
  expiryDate    DateTime?
}

// ============================= CLIENTES =============================
model Client {
  id        Int       @id @default(autoincrement())
  name      String
  ciNit     String    @unique
  address   String?
  phone     String?
  email     String?
  createdAt DateTime  @default(now())
  sales     Sale[]
}

// ============================= VENTAS =============================
model Sale {
  id            Int        @id @default(autoincrement())
  number        String     @unique
  branchId      Int
  branch        Branch     @relation(fields: [branchId], references: [id])
  userId        Int
  user          User       @relation(fields: [userId], references: [id])
  clientId      Int?
  client        Client?    @relation(fields: [clientId], references: [id])
  type          String     @default("SIMPLE") // SIMPLE
  paymentMethod String     @default("EFECTIVO") // EFECTIVO | TARJETA | QR
  paymentStatus String     @default("PAID") // PAID
  total         Decimal    @db.Decimal(10, 2)
  status        String     @default("ACTIVE") // ACTIVE | ANNULLED | DELETED
  note          String?
  createdAt     DateTime   @default(now())
  items         SaleItem[]
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)
}

// ============================= FACTURACION =============================
// El modulo de facturacion electronica (SIN) fue eliminado por requerimiento.
// Las ventas son simples (efectivo); la referencia de factura del proveedor
// se guarda en Purchase.invoiceNumber.

// ============================= LICENCIAS =============================
model License {
  id          String   @id @default(uuid())
  module      String   @unique // POS | REPORTES | BACKUPS | INVENTARIO
  status      String   @default("INACTIVE") // ACTIVE | INACTIVE
  license_key String?
  activatedAt DateTime?
  createdAt   DateTime @default(now())
}

// ============================= BACKUPS =============================
model Backup {
  id        Int      @id @default(autoincrement())
  type      String // LOCAL | DRIVE
  status    String   @default("RUNNING") // RUNNING | SUCCESS | FAILED
  filename  String?
  path      String?
  sizeBytes BigInt?
  error     String?
  createdAt DateTime @default(now())
}
